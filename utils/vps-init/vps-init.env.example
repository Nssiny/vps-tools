# vps-init 配置（/etc/vps-init.env，chmod 600，可缺省）
# 向导模式可留空（每步交互询问）；非交互/预填用以下变量：

# 要创建的普通用户（空 = 向导询问；留空确认跳过 = root-only）
VPS_INIT_USER=

# 普通用户密码（sudo 提权用；空 = 向导询问）
VPS_INIT_USER_PASS=

# SSH 公钥内容或文件路径（空 = 向导询问/粘贴）
VPS_INIT_SSH_PUBKEY=

# SSH 端口（空 = SSH_PORT_MIN~MAX 随机生成）
VPS_INIT_SSH_PORT=

# 随机端口范围
SSH_PORT_MIN=20000
SSH_PORT_MAX=60000

# UFW 额外放行端口，逗号分隔（如 80,443 或 53/udp）
VPS_INIT_EXTRA_PORTS=

# 1 = 跳过创建普通用户（root-only）
VPS_INIT_SKIP_USER=0

# 1 = 禁用 root 登录（仅密钥；须先确认普通用户密钥可登录）
VPS_INIT_DISABLE_ROOT=0

# 1 = 向导不逐项确认（CI/无人值守）
VPS_INIT_YES=0
