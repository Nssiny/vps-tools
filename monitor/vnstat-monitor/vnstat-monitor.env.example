# ==========================================
# vnstat-monitor 配置文件
# 安装后请编辑本文件填入真实密钥
# ==========================================

# 1. 自定义 VPS 名称 (用于 Telegram 消息卡片和告警显示)
VPS_NAME="My Web Server"

# 2. 监控的网卡名称
# 设置为 "auto" 时，脚本会自动寻找当前主路由的网卡（推荐）。
INTERFACE="auto"

# 3. 流量计算模式
# 可选值: both (双向相加), out (仅出站), in (仅入站), max (出入站取较大值)
CALC_MODE="both"

# 4. 流量重置日 (1-28)
# 例如每月 15 日重置流量，则填 15。脚本会自动接管并调整底层统计周期。
RESET_DAY="1"

# 5. 流量总量 (单位: GB)
# 设置为 0 则代表该机器为 无限流量 (Unlimited)，不再显示进度条和触发关机。
TOTAL_GB="1000"

# 6. 手动校准偏移量 (单位: GB)
# 若发现 vnstat 统计的数据与云服务商账单有偏差，可用此项修正。
# 例如：填 "10" 表示在基础流量上额外加 10GB；填 "-5" 表示减去 5GB。默认为 0。
OFFSET_GB="0"

# 7. 自动关机阈值百分比 (0-100)
# 当使用量达到此百分比时，立即触发报警并关机。例如 95 代表 95%。
# 注意：当 TOTAL_GB="0" (无限流量) 时，此项自动失效。
SHUTDOWN_PERCENT="95"

# 8. Telegram 机器人配置
# 在 Telegram 中联系 @BotFather 创建机器人获取 Token
TG_BOT_TOKEN="${TG_BOT_TOKEN}"
TG_CHAT_ID="${TG_CHAT_ID}"

# 9. 定时触发频率 (单位: 分钟)
# 通过 systemd timer 调度（替代 crontab）。修改后运行: sudo vnstat-monitor set-interval <分钟>
# 默认 15 分钟检查一次。
INTERVAL_MINUTES="15"

# 10. 状态保存路径 (无需修改)
STATE_FILE="/var/lib/vnstat-monitor/state.env"
